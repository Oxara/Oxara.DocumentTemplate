  "document-hero": {
    "css": [
      "features/document-hero/document-hero.css"
    ],
    "js": [
      "features/document-hero/document-hero.js"
    ],
    "requires": [
      "base",
      "docs-layout"
    ],
    "provides": [
      "optional illustrated landing hero",
      "consumer background/prop/growth slots",
