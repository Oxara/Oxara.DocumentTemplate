      "assets/oxara-mark.svg",
      "assets/oxara-mark-on-dark.svg",
      "assets/oxara-mark.png",
      "assets/oxara-mark-96.png",
      "assets/oxara-mark-192.png",
      "assets/favicon.svg",
      "assets/favicon.ico",
      "favicon-48.png",
      "apple-touch-icon.png",
      ".docs-shell",
      "[data-docs-sidebar]",
      "[data-docs-toc]",
      "[data-docs-nav-toggle]",
      "[data-docs-overlay]"
    ],
    "api": [
      "docsLayout.toggleNavigation()",
      "docsLayout.closeNavigation()"
    ]
  },
  "theme": {
    "css": [
      "features/theme/theme.css"
    ],
    "js": [
