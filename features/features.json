{
  "base": {
    "css": [
      "features/base/base.css"
    ],
    "js": [],
    "requires": [],
    "provides": [
      "design tokens",
      "common document styles",
      "header-actions layout",
      "skip-link accessibility",
      "optional section dividers",
      "slogan banner",
      "content figures",
      "subtle page-edge indicator with forced-colours fallback",
      "Brand-derived semantic theme colors and light/dark contrast roles"
    ],
    "html": [
      ".skip-link",
      ".section-dividers",
      ".slogan-banner",
      ".content-figure"
    ]
  },
  "resource-card": {
    "css": [
      "features/resource-card/resource-card.css"
    ],
    "js": [],
    "requires": [
      "base"
    ],
    "provides": [
      "multi-destination resource cards",
      "explicit repository and distribution links",
      "optional split-color icon actions"
    ],
    "html": [
      ".resource-card-grid",
      ".resource-card",
      ".resource-card__links",
      ".resource-card__action"
    ]
  },
  "author-link": {
    "css": [
      "features/author-link/author-link.css"
    ],
    "js": [],
    "requires": [
      "base"
    ],
    "provides": [
      "compact author link",
      "site return link for document headers"
    ],
    "html": [
      ".author-link"
    ]
  },
  "docs-layout": {
    "css": [
      "features/docs-layout/docs-layout.css"
    ],
    "js": [
      "features/docs-layout/docs-layout.js"
    ],
    "requires": [
      "base"
    ],
    "provides": [
      "multi-page documentation shell",
      "persistent site navigation",
