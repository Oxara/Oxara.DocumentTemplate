      ".document-hero-art",
      ".document-hero-copy",
      ".document-hero-book",
      ".document-hero-edge"
    ],
    "api": [
      "documentHero.init(root?)",
      "documentHero.destroy(root?)"
    ],
    "assets": [
      "assets/presentation/atlas-painted-v1.webp",
      "assets/presentation/book-painted-v1.webp"
    ],
    "defaults": {
      "background": "assets/presentation/atlas-painted-v1.webp",
      "prop": "assets/presentation/book-painted-v1.webp",
      "override": "optional .document-hero-art and .document-hero-book slots",
      "textOnly": "data-hero-layout=\"text\""
    }
